# Secrets — never commit
*.env
*.tfvars
!*.tfvars.example

# OpenTofu / Terraform plugin cache and downloaded providers
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
crash.log

# Terragrunt-generated files (regenerated on each run)
terraform/**/provider.tf
terraform/**/backend.tf
terraform/**/data.tf

# OS / IDE
.DS_Store
.idea/
*.iml
